  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"grade\" INTEGER NOT NULL CHECK(\"grade\" BETWEEN 1 AND 12), \"color\" TEXT NOT NULL, \"pin_hash\" TEXT NULL, \"pin_salt\" TEXT NULL, \"student_code\" TEXT NOT NULL UNIQUE, \"class_code\" TEXT NULL, \"equipped\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"last_active_at\" INTEGER NOT NULL, \"revision\" INTEGER NOT NULL DEFAULT 0, \"local_version\" INTEGER NOT NULL DEFAULT 0, \"synced_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "lesson_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lesson_progress\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"lesson_id\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"progress\" REAL NOT NULL DEFAULT 0.0, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"profile_id\", \"lesson_id\"));"
        }
      ]
    },
    {
      "name": "lesson_part_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lesson_part_progress\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"lesson_id\" TEXT NOT NULL, \"part\" TEXT NOT NULL, \"completed_at\" INTEGER NOT NULL, \"synced_at\" INTEGER NULL, PRIMARY KEY (\"profile_id\", \"lesson_id\", \"part\"));"
        }
      ]
    },
    {
      "name": "owned_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"owned_items\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"item_id\" TEXT NOT NULL, \"cost\" INTEGER NOT NULL, \"acquired_at\" INTEGER NOT NULL, \"synced_at\" INTEGER NULL, PRIMARY KEY (\"profile_id\", \"item_id\"));"
        }
      ]
    },
    {
      "name": "attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attempts\" (\"id\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"activity_id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"score\" INTEGER NOT NULL, \"total\" INTEGER NOT NULL, \"stars_earned\" INTEGER NOT NULL DEFAULT 0, \"hints_used\" INTEGER NOT NULL DEFAULT 0, \"details_json\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"synced_at\" INTEGER NULL, \"server_received_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "concept_mastery",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"concept_mastery\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"concept_id\" TEXT NOT NULL, \"mastery\" REAL NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"profile_id\", \"concept_id\"));"
        }
      ]
    },
    {
      "name": "bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarks\" (\"profile_id\" TEXT NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"lesson_id\" TEXT NOT NULL, \"removed_at\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL, \"local_version\" INTEGER NOT NULL DEFAULT 0, \"synced_at\" INTEGER NULL, PRIMARY KEY (\"profile_id\", \"lesson_id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
